---
import BaseLayout from '../layouts/BaseLayout.astro';
import DemoForm from '../components/DemoForm.astro';

export const prerender = false;

const ok = Astro.url.searchParams.get('ok') === '1';
const err = Astro.url.searchParams.get('err') === '1';
---
<BaseLayout
  title="Request a demo — Loop"
  description="A 20-minute personalized walkthrough of Loop, tailored to your team."
>
  <section class="bg-white">
    <div class="mx-auto max-w-6xl px-6 pt-16 pb-20 md:pt-20">
      <div class="max-w-2xl">
        <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-zinc-950">
          See Loop in action.
        </h1>
        <p class="mt-4 text-lg text-zinc-600">
          Tell us about your team. We'll send a 20-minute personalized walkthrough.
        </p>
      </div>

      <div class="mt-12 grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16">
        <div>
          <h2 class="text-lg font-semibold text-zinc-950">What to expect</h2>
          <ul class="mt-6 space-y-3">
            <li class="flex items-start gap-3 text-zinc-700 leading-relaxed">
              <span class="mt-2 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-zinc-400" aria-hidden="true"></span>
              <span>A 20-minute walkthrough using your team's actual workflow as the example.</span>
            </li>
            <li class="flex items-start gap-3 text-zinc-700 leading-relaxed">
              <span class="mt-2 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-zinc-400" aria-hidden="true"></span>
              <span>Honest answers about what Loop is and is not a good fit for. Teams of 5 to 50 are the sweet spot.</span>
            </li>
            <li class="flex items-start gap-3 text-zinc-700 leading-relaxed">
              <span class="mt-2 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-zinc-400" aria-hidden="true"></span>
              <span>No sales script. No follow-up drip. If you want to try it, we will set you up. If not, that is fine too.</span>
            </li>
            <li class="flex items-start gap-3 text-zinc-700 leading-relaxed">
              <span class="mt-2 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-zinc-400" aria-hidden="true"></span>
              <span>The recording afterwards, so you can share it with anyone on your team who could not make it.</span>
            </li>
          </ul>

          <figure class="mt-10 rounded-xl border border-zinc-200 bg-zinc-50 p-6">
            <blockquote class="text-zinc-700 leading-relaxed">
              "Walked through Loop on a Wednesday, had it running with our team on Friday. Took
              less than 30 minutes to set up and our engineers actually like it."
            </blockquote>
            <figcaption class="mt-4 flex items-center gap-3">
              <div class="h-9 w-9 rounded-full bg-zinc-100 flex items-center justify-center text-xs font-semibold text-zinc-700">
                DH
              </div>
              <div class="text-sm">
                <div class="font-medium text-zinc-950">Diego Herrera</div>
                <div class="text-zinc-600">Head of Engineering, Bramble</div>
              </div>
            </figcaption>
          </figure>
        </div>

        <div>
          {
            ok ? (
              <div class="rounded-xl border border-emerald-200 bg-emerald-50 p-6">
                <div class="flex items-start gap-3">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0 text-emerald-600" aria-hidden="true">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                    <polyline points="22 4 12 14.01 9 11.01" />
                  </svg>
                  <div>
                    <h3 class="font-semibold text-zinc-950">Thanks. We'll be in touch.</h3>
                    <p class="mt-1 text-zinc-700">A reply with a few walkthrough times will land in your inbox within one business day.</p>
                  </div>
                </div>
              </div>
            ) : (
              <>
                {err && (
                  <div class="mb-4 rounded-md border border-red-200 bg-red-50 p-4 text-sm text-red-700">
                    Something went wrong. Please email us directly at <a href="mailto:hello@loop.com" class="underline">hello@loop.com</a>.
                  </div>
                )}
                <DemoForm />
              </>
            )
          }
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
