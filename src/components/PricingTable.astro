---
interface Tier {
  name: string;
  price: string;
  priceSuffix?: string;
  description: string;
  features: string[];
  cta: { label: string; href: string };
  featured?: boolean;
}

interface Props {
  tiers?: Tier[];
}

const {
  tiers = [
    {
      name: 'Starter',
      price: '$19',
      priceSuffix: '/seat/month',
      description: 'For small teams trying async standups for the first time.',
      features: [
        'Up to 10 team members',
        'Daily standup digest in Slack',
        'GitHub & Linear integrations',
        'Email support',
        '30-day history',
      ],
      cta: { label: 'Start free trial', href: '#' },
    },
    {
      name: 'Growth',
      price: '$49',
      priceSuffix: '/seat/month',
      description: 'For growing teams that need visibility across squads.',
      features: [
        'Up to 50 team members',
        'Custom standup formats and schedules',
        'Cross-team dashboards',
        'All integrations',
        'Priority support',
        '1-year history',
        'Weekly leadership summary',
      ],
      cta: { label: 'Start free trial', href: '#' },
      featured: true,
    },
    {
      name: 'Scale',
      price: 'Custom',
      description: 'For larger orgs with SSO, audit, and procurement requirements.',
      features: [
        'Unlimited team members',
        'SSO (SAML, Okta)',
        'SOC 2 Type II report',
        'Custom data residency',
        'Dedicated success manager',
        'Unlimited history',
        '99.9% uptime SLA',
      ],
      cta: { label: 'Contact sales', href: '/demo' },
    },
  ],
} = Astro.props;
---
<section class="bg-white">
  <div class="mx-auto max-w-6xl px-6 py-16 md:py-20">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {
        tiers.map((tier) => (
          <div
            class={`relative rounded-2xl border bg-white p-8 ${
              tier.featured
                ? 'border-zinc-950 ring-1 ring-zinc-950 shadow-lg'
                : 'border-zinc-200'
            }`}
          >
            {tier.featured && (
              <div class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-zinc-950 px-3 py-1 text-xs font-semibold text-white">
                Most popular
              </div>
            )}
            <h3 class="text-lg font-semibold text-zinc-950">{tier.name}</h3>
            <div class="mt-4 flex items-baseline gap-1">
              <span class="text-4xl font-bold tracking-tight text-zinc-950">{tier.price}</span>
              {tier.priceSuffix && (
                <span class="text-sm text-zinc-600">{tier.priceSuffix}</span>
              )}
            </div>
            <p class="mt-3 text-sm text-zinc-600">{tier.description}</p>
            <a
              href={tier.cta.href}
              class={`mt-6 inline-flex w-full items-center justify-center rounded-md px-4 py-2.5 text-sm font-medium transition-colors ${
                tier.featured
                  ? 'bg-zinc-950 text-white hover:bg-zinc-800'
                  : 'border border-zinc-300 bg-white text-zinc-950 hover:border-zinc-950 hover:bg-zinc-50'
              }`}
            >
              {tier.cta.label}
            </a>
            <ul class="mt-8 space-y-3">
              {tier.features.map((feature) => (
                <li class="flex items-start gap-3 text-sm text-zinc-700">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 flex-shrink-0 text-zinc-700" aria-hidden="true">
                    <polyline points="20 6 9 17 4 12" />
                  </svg>
                  <span>{feature}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
